{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "econ-reference-matcher sealed gold",
  "type": "object",
  "required": ["task_id", "target_claims", "category_gold", "scoring"],
  "properties": {
    "task_id": { "type": "string" },
    "canaries": {
      "type": "array",
      "items": { "type": "string" }
    },
    "target_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "text"],
        "properties": {
          "claim_id": { "type": "string" },
          "text": { "type": "string" },
          "type": { "type": "string" },
          "citation_need": { "type": "string" }
        }
      }
    },
    "must_find": { "type": "array", "items": { "type": "object" } },
    "acceptable_alternatives": { "type": "array", "items": { "type": "object" } },
    "forbidden_decoys": { "type": "array", "items": { "type": "object" } },
    "claim_to_paper_map": { "type": "array", "items": { "type": "object" } },
    "evidence_requirements": { "type": "array", "items": { "type": "object" } },
    "category_gold": { "type": "array", "items": { "type": "object" } },
    "journal_filter_gold": { "type": "array", "items": { "type": "object" } },
    "paper_ready_requirements": { "type": "object" },
    "expert_notes": { "type": "string" },
    "scoring": { "type": "object" }
  }
}
